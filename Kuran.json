    },
    {
      "id": "sure-103",
      "tur": "sure",
      "no": 103,
      "ad": "Asr",
      "adArapca": "العصر",
      "konum": "103. sûre",
      "ayetSayisi": 3,
      "inis": "Mekkî",
      "arapca": [
        "وَالْعَصْرِ",
        "إِنَّ الْإِنْسَانَ لَفِي خُسْرٍ",
        "إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ"
      ],
      "okunus": [
        "Vel asr.",
        "İnnel insâne lefî husr.",
        "İllellezîne âmenû ve amilüs sâlihâti ve tevâsav bil hakkı ve tevâsav bis sabr."
      ],
      "meal": [
        "Asra yemin olsun ki,",
        "insan gerçekten ziyandadır.",
        "Ancak iman edip iyi işler yapanlar, birbirine hakkı ve sabrı tavsiye edenler başka."
      ]
    },
    {
      "id": "sure-104",
      "tur": "sure",
      "no": 104,
      "ad": "Hümeze",
      "adArapca": "الهمزة",
      "konum": "104. sûre",
      "ayetSayisi": 9,
      "inis": "Mekkî",
      "arapca": [],
      "okunus": [],
      "meal": []
    },
    {
      "id": "sure-105",
      "tur": "sure",
      "no": 105,
      "ad": "Fîl",
      "adArapca": "الفيل",
      "konum": "105. sûre",
      "ayetSayisi": 5,
      "inis": "Mekkî",
      "arapca": [
        "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَابِ الْفِيلِ",
        "أَلَمْ يَجْعَلْ كَيْدَهُمْ فِي تَضْلِيلٍ",
        "وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ",
        "تَرْمِيهِمْ بِحِجَارَةٍ مِنْ سِجِّيلٍ",
        "فَجَعَلَهُمْ كَعَصْفٍ مَأْكُولٍ"
      ],
      "okunus": [
        "Elem tera keyfe feale rabbüke bi ashâbil fîl.",
        "Elem yec'al keydehüm fî tadlîl.",
        "Ve ersele aleyhim tayran ebâbîl.",
        "Termîhim bi hicâratin min siccîl.",
        "Fecealehüm keasfin me'kûl."
      ],
      "meal": [
        "Rabbinin fil sahiplerine ne yaptığını görmedin mi?",
        "Onların tuzaklarını boşa çıkarmadı mı?",
        "Üzerlerine sürü sürü kuşlar gönderdi.",
        "O kuşlar onlara pişkin çamurdan taşlar atıyordu.",
        "Sonunda onları yenmiş ekin yaprağına çevirdi."
      ]
    },
    {
      "id": "sure-106",
      "tur": "sure",
      "no": 106,
      "ad": "Kureyş",
      "adArapca": "قريش",
      "konum": "106. sûre",
      "ayetSayisi": 4,
      "inis": "Mekkî",
      "arapca": [
        "لِإِيلَافِ قُرَيْشٍ",
        "إِيلَافِهِمْ رِحْلَةَ الشِّتَاءِ وَالصَّيْفِ",
        "فَلْيَعْبُدُوا رَبَّ هَٰذَا الْبَيْتِ",
        "الَّذِي أَطْعَمَهُمْ مِنْ جُوعٍ وَآمَنَهُمْ مِنْ خَوْفٍ"
      ],
      "okunus": [
        "Li îlâfi kurayş.",
        "Îlâfihim rihleteş şitâi ves sayf.",
        "Felya'büdû rabbe hâzel beyt.",
        "Ellezî at'amehüm min cûin ve âmenehüm min havf."
      ],
      "meal": [
        "Kureyş'i alıştırdığı için,",
        "onları kış ve yaz yolculuğuna alıştırdığı için,",
        "bu Ev'in Rabbine kulluk etsinler.",
        "O Rab ki onları açlıktan doyurdu ve korkudan güvene kavuşturdu."
      ]
    },
    {
      "id": "sure-107",
      "tur": "sure",
      "no": 107,
      "ad": "Mâûn",
      "adArapca": "الماعون",
      "konum": "107. sûre",
      "ayetSayisi": 7,
      "inis": "Mekkî",
      "arapca": [
